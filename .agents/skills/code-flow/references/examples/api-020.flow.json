  "omitted": [
    "인증·CSRF 필터, 생성자·getter, Spring 프록시 내부, Repository의 프레임워크 내부를 생략했다.",
    "자기소개서 조회 실패의 NOT_FOUND는 Repository 반환 이후 Service에서 발생한다. 상세 예외 경로는 개요 노트로 축약했다.",
    "Listener의 Job 조회·dispatch와 Worker의 실패 처리 private 메서드는 개요 안에 묶었다.",
    "Job terminal 상태에 따른 조기 종료, 클라이언트 검증 내부, 실패 기록 자체의 예외·로그 처리는 근거 코드에서 확인한다.",
    "SSE와 최종 결과 재조회는 API-016/API-021의 별도 요청이므로 이 호출 스택에 포함하지 않았다."
  ],
  "uncertain": [
    "정적 소스 해석이며 T1/T2/T3의 실제 실행은 계측하지 않았다.",
    "HTTP 응답과 비동기 Worker의 시작·완료 순서는 고정할 수 없다.",
    "트랜잭션 범위는 주요 사용자 코드 경계다. 생략한 Repository 내부 트랜잭션의 부재를 뜻하지 않는다."
  ],
  "calls": [
    {
      "id": "controller",
      "class": "KeywordAnalysisController",
      "method": "startKeywordAnalysis(coverLetterId)",
      "source": "controller",
      "steps": [
        {
          "type": "call",
          "target": "service",
          "source": "controller"
        },
        {
          "type": "call",
          "target": "dto",
          "source": "controller"
        }
      ],
      "returns": "HTTP 200 · status=PROCESSING, jobId (예외는 공통 처리기로 전파)",
      "note": "Service 호출이 끝날 때까지 Controller 호출이 유지된다."
    },
    {
      "id": "service",
      "class": "KeywordAnalysisService",
      "method": "startMyKeywordAnalysis(coverLetterId)",
      "source": "service",
      "steps": [
        {
          "type": "note",
          "text": "currentUser()로 사용자 확인",
          "source": "service"
        },
        {
          "type": "call",
          "target": "lock",
          "source": "service"
        },
        {
          "type": "note",
          "text": "대상이 없으면 NOT_FOUND → T1 롤백 → HTTP 404",
          "source": "service"
        },
        {
          "type": "branch",
          "label": "성공한 첨삭 버전 존재 여부",
          "source": "service",
          "cases": [
            {
              "when": "latestReviewedVersionId == null",
              "steps": [
                {
                  "type": "throw",
                  "text": "CONFLICT → T1 롤백 → HTTP 409",
                  "source": "service"
                }
              ]
            },
            {
              "when": "성공한 첨삭 버전 있음",
              "steps": [
                {
                  "type": "call",
                  "target": "running",
                  "source": "service"
                },
                {
                  "type": "branch",
                  "label": "진행 중 Job에 따른 세 경로 중 하나",
                  "source": "service",
                  "cases": [
                    {
                      "when": "동일 KEYWORD_ANALYSIS 진행 중",
                      "steps": [
                        {
                          "type": "note",
                          "text": "기존 KeywordAnalysis 조회",
                          "source": "service"
                        },
                        {
                          "type": "return",
                          "text": "기존 Job 반환 · 새 이벤트 발행 없음",
                          "source": "service"
                        }
                      ]
                    },
                    {
                      "when": "다른 종류의 Job 진행 중",
                      "steps": [
                        {
                          "type": "throw",
                          "text": "LLM_JOB_ALREADY_RUNNING → T1 롤백 → HTTP 409",
                          "source": "service"
                        }
                      ]
                    },
                    {
                      "when": "진행 중 Job 없음",
                      "steps": [
                        {
                          "type": "note",
                          "text": "KeywordAnalysis 조회 → 기존 분석 재시작 또는 새 분석 저장 → PENDING Job 저장",
                          "source": "service"
                        },
                        {
                          "type": "note",
                          "text": "publishEvent(LlmJobCreatedEvent(jobId)) · Service 본문 반환 뒤 프록시가 T1 커밋",
                          "source": "service"
                        },
                        {
                          "type": "async",
                          "target": "listener",
                          "source": "listener",
                          "label": "LlmJobCreatedEvent → KeywordAnalysisJobEventListener",
                          "trigger": "새 Job 경로 · T1 AFTER_COMMIT + @Async (호출 본문에서 즉시 실행 아님)"
                        },
                        {
                          "type": "return",
                          "text": "StartKeywordAnalysisResult · 새 Job",
                          "source": "service"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ],
      "returns": "선택 경로의 결과 · 정상 반환 시 T1 커밋 / 예외 시 롤백",
      "note": "비동기 연결의 trigger는 커밋 이후를 뜻한다. 녹색 영역은 이벤트 발행을 포함하지만 Worker를 포함하지 않는다.",
      "tx": {
        "id": "T1",
        "label": "REQUIRED · Service 프록시의 요청 트랜잭션"
      }
    },
    {
