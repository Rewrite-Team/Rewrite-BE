      "class": "CoverLetterRepository",
      "method": "findActiveByIdAndOwnerIdForUpdate(...)",
      "source": "lock",
      "steps": [],
      "returns": "Optional<CoverLetter>",
      "note": "T1의 데이터 접근 · PESSIMISTIC_WRITE"
    },
    {
      "id": "running",
      "class": "LlmJobService",
      "method": "findRunningCoverLetterJob(coverLetterId)",
      "source": "running",
      "steps": [],
