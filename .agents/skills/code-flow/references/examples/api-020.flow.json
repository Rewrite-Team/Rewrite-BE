      "note": "같은 스레드의 T1 안에서 Repository 조회. 이 메서드 자체에는 @Transactional이 없다."
    },
    {
      "id": "dto",
      "class": "StartKeywordAnalysisResponse",
      "method": "from(result)",
      "source": "dto",
      "steps": [],
      "returns": "status, jobId",
      "note": "트랜잭션이 끝난 뒤 DTO로 변환한다."
    },
    {
      "id": "listener",
      "class": "KeywordAnalysisJobEventListener",
      "method": "handle(event) → dispatch(job)",
      "source": "listener",
      "steps": [
        {
          "type": "note",
          "text": "Job 조회 · KEYWORD_ANALYSIS인 경우만 Worker 호출",
          "source": "listener"
        },
        {
          "type": "call",
          "target": "worker",
          "source": "listener"
        }
      ],
      "returns": "void · 별도 스택 종료",
      "note": "handle→dispatch는 동일 클래스의 두 호출을 묶은 개요다. 요청 스레드의 T1은 전파되지 않는다."
    },
    {
      "id": "worker",
      "class": "KeywordAnalysisJobWorker",
      "method": "execute(jobId)",
      "source": "worker",
      "steps": [
        {
          "type": "branch",
          "label": "try 경로 또는 catch 경로 · 오류 위치에 따라 선행 호출은 달라짐",
          "source": "worker",
          "cases": [
            {
              "when": "예외 없이 실행",
              "steps": [
                {
                  "type": "call",
                  "target": "start",
                  "source": "worker"
                },
                {
                  "type": "branch",
                  "label": "입력 준비 결과",
                  "source": "worker",
                  "cases": [
                    {
                      "when": "start() == null",
                      "steps": [
                        {
                          "type": "return",
                          "text": "Worker 조기 종료 · 분석 호출 없음",
                          "source": "worker"
                        }
                      ]
                    },
                    {
                      "when": "Work 반환",
                      "steps": [
                        {
                          "type": "call",
                          "target": "client",
                          "source": "worker"
                        },
                        {
                          "type": "call",
                          "target": "complete",
                          "source": "worker"
                        },
                        {
                          "type": "return",
                          "text": "분석 저장 완료 · void",
                          "source": "worker"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "when": "KeywordAnalysisClientException 포착",
              "steps": [
                {
                  "type": "note",
                  "text": "analyze()에서 오류 발생. 실패 전 부분 실행과 failByClientException() 내부 호출을 축약",
                  "source": "worker"
                },
                {
                  "type": "call",
                  "target": "failure",
                  "source": "worker"
                },
                {
                  "type": "return",
                  "text": "실패 기록 후 void",
                  "source": "worker"
                }
              ]
            },
            {
              "when": "그 외 RuntimeException 포착",
              "steps": [
                {
                  "type": "note",
                  "text": "start/analyze/complete 중 오류 발생. 실패 전 부분 실행과 failByUnexpectedException() 내부 호출을 축약",
                  "source": "worker"
                },
                {
                  "type": "call",
                  "target": "unexpected",
                  "source": "worker"
                },
                {
                  "type": "return",
                  "text": "실패 기록 후 void",
                  "source": "worker"
                }
              ]
            }
          ]
        }
      ],
      "returns": "void · Listener로 반환",
      "note": "try는 start, analyze, complete를 감싼다. catch 경로는 start 또는 complete에서 발생한 RuntimeException도 포함한다. 대안 구간의 높이는 실제 발생 순서를 나타내지 않는다."
    },
    {
      "id": "start",
      "class": "KeywordAnalysisJobTransactionService",
      "method": "start(jobId)",
      "source": "start",
      "steps": [
        {
          "type": "note",
          "text": "Job·자기소개서 잠금, 분석 입력 조회, PROCESSING 전환",
          "source": "start"
        }
      ],
      "returns": "T2 커밋 후 Work 또는 null; 오류 시 롤백 후 예외",
      "note": "외부 T1과 별도이며 Worker에 기존 트랜잭션이 없어 REQUIRED가 새 트랜잭션을 만든다.",
      "tx": {
        "id": "T2",
        "label": "REQUIRED · 분석 입력 준비"
      }
    },
    {
      "id": "client",
      "class": "OpenAiKeywordAnalysisClient",
      "method": "analyze(request)",
      "source": "client",
      "steps": [],
      "returns": "키워드 결과 목록 / KeywordAnalysisClientException",
      "note": "LLM 호출과 결과 검증. T2 커밋 이후이며 T3 시작 전이다."
    },
    {
      "id": "complete",
      "class": "KeywordAnalysisJobTransactionService",
      "method": "complete(jobId, results)",
      "source": "complete",
      "steps": [
        {
          "type": "note",
          "text": "기존 키워드 교체, 분석·Job COMPLETED",
          "source": "complete"
        }
      ],
      "returns": "T3 커밋 후 void; 오류 시 롤백 후 예외",
      "note": "terminal 상태 조기 반환 등은 소스에서 확인한다.",
      "tx": {
        "id": "T3",
        "label": "REQUIRED · 분석 결과 저장"
      }
    },
    {
      "id": "failure",
      "class": "KeywordAnalysisJobTransactionService",
      "method": "fail(jobId, reason)",
      "source": "fail",
      "steps": [
        {
          "type": "note",
          "text": "Job·KeywordAnalysis FAILED 기록",
          "source": "fail"
        }
      ],
      "returns": "실패 기록 TX 커밋 후 void",
      "note": "이미 커밋된 T1/T2를 되돌리지 않는다.",
      "tx": {
        "id": "TF",
        "label": "REQUIRED · Client 실패 기록"
      }
    },
    {
      "id": "unexpected",
      "class": "KeywordAnalysisJobTransactionService",
      "method": "failUnexpected(jobId)",
      "source": "unexpected",
      "steps": [
        {
          "type": "note",
          "text": "Job FAILED, PROCESSING 분석이 있으면 FAILED",
          "source": "unexpected"
        }
      ],
      "returns": "실패 기록 TX 커밋 후 void",
      "note": "실패 기록 자체가 실패하면 Worker에서 로그를 남긴다.",
      "tx": {
        "id": "TU",
        "label": "REQUIRED · 예상 밖 실패 기록"
      }
    }
  ]
